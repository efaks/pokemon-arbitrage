# Copy to .env in the repository root and fill in only the services you use.
# Shell variables take precedence. Set ARBITRAGE_SKIP_DOTENV=1 in the shell to skip loading.
# Keep .env local and out of version control.

# eBay Browse uses client credentials or a static application access token.
# Member checkout requires approved Order API access and a user refresh or access token.
EBAY_CLIENT_ID=
# OAuth redirect name (RuName) registered in the eBay developer portal.
EBAY_RU_NAME=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_ACCESS_TOKEN=
EBAY_ORDER_API_TOKEN=

# eBay Sell Inventory and Fulfillment. Use approved policies and a user grant with the Sell scopes.
# A blank Sell refresh token falls back to EBAY_REFRESH_TOKEN if that token has the Sell scope.
EBAY_SELL_API_TOKEN=
EBAY_SELL_REFRESH_TOKEN=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_SELL_SANDBOX=false
ARBITRAGE_AUTO_PUBLISH_LISTINGS=false

# Market sync. Enable Marketplace Insights only with approved access.
POKEMON_TCG_API_KEY=
PRICECHARTING_API_TOKEN=
EBAY_INSIGHTS_ENABLED=false
EBAY_INSIGHTS_CATEGORY_IDS=

# Vision and alerts. Live vision requires an OpenAI-compatible URL and API key.
VISION_API_KEY=
VISION_API_URL=
VISION_MODEL=gpt-4o-mini
ARBITRAGE_WEBHOOK_URL=

# Retailers and PSA. Use authorized HTTPS feeds and approved Shopify storefront domains.
BESTBUY_API_KEY=
COSTCO_FEED_URL=
COSTCO_API_KEY=
COSTCO_WAREHOUSE_ID=
POKEMON_CENTER_FEED_URL=
POKEMON_CENTER_API_KEY=
POKEMON_CENTER_REGION=US
LGS_SHOPIFY_DOMAINS=
TCGPLAYER_API_TOKEN=
PSA_API_TOKEN=

# Leave mode blank to keep the database mode on MCP startup. New databases start in shadow.
ARBITRAGE_MODE=
ARBITRAGE_DB_PATH=data/arbitrage.sqlite

# Monetary limits are integer USD cents. Review them with the operator before live checkout.
ARBITRAGE_DAILY_CAP_CENTS=100000
ARBITRAGE_AUTO_BUY_MAX_ORDER_CENTS=50000
ARBITRAGE_MAX_POSITION_PER_SKU=5
ARBITRAGE_CASH_BALANCE_CENTS=500000
ARBITRAGE_MIN_CASH_RESERVE_CENTS=50000
ARBITRAGE_ALLOW_RAW_AUTO_BUY=false

# Evaluation and circuit breaker thresholds.
ARBITRAGE_MIN_PROFIT_CENTS=1500
ARBITRAGE_MIN_NET_ROI=0.15
ARBITRAGE_MIN_LIQUIDITY_SCORE=0.30
ARBITRAGE_MIN_MATCH_CONFIDENCE=0.80
ARBITRAGE_MAX_ANOMALY_DISCOUNT=0.60
ARBITRAGE_SALES_TAX_RATE=0.08
ARBITRAGE_STALE_COMP_MAX_AGE_DAYS=21
ARBITRAGE_MIN_COMP_COUNT=3
ARBITRAGE_SELLER_MIN_FEEDBACK=50
ARBITRAGE_SELLER_MIN_POSITIVE_PERCENT=98.5
ARBITRAGE_SELLER_MIN_ACCOUNT_AGE_DAYS=90
ARBITRAGE_CIRCUIT_BREAKER_MAX_ERRORS_PER_WINDOW=5
