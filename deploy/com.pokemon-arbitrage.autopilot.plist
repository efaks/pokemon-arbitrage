<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pokemon-arbitrage.autopilot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>src/cli.ts</string>
    <string>autopilot</string>
    <string>--db</string>
    <string>data/arbitrage.sqlite</string>
    <string>--sync-ms</string>
    <string>3600000</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/opt/pokemon-arbitrage</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>Umask</key>
  <integer>63</integer>
</dict>
</plist>
